# Copy to .env.local. Everything is optional: with nothing set, leads are
# logged to the server console and the widget still shows "Done!".

# --- Email alert via Resend (https://resend.com, free tier) ---------------
# onboarding@resend.dev works without domain verification but can only
# deliver to the email on your Resend account. Verify a domain to send anywhere.
RESEND_API_KEY=
LEAD_TO_EMAIL=you@example.com
LEAD_FROM_EMAIL="Jake Miller Realty <onboarding@resend.dev>"

# --- Optional: also POST the lead JSON to a Zapier / Make webhook ----------
# Use this to fan out to SMS, Google Sheets, a CRM, etc.
LEAD_WEBHOOK_URL=
